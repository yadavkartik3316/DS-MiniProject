    {
      "name": "2. Predict Rain",
      "item": [
        {
          "name": "Test 1 - Valid Request (Rainy Conditions)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"min_temp\": 18,\n  \"max_temp\": 24,\n  \"humidity\": 90,\n  \"wind_speed\": 40,\n  \"pressure\": 1005,\n  \"sunshine\": 1,\n  \"evaporation\": 2,\n  \"cloud\": 8,\n  \"wind_dir\": \"SE\",\n  \"location\": \"Brisbane\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/predict-rain",
              "host": ["{{base_url}}"],
              "path": ["predict-rain"]
            },
            "description": "High humidity, low sunshine, high cloud — likely rain. Expects rain_tomorrow and probability."
          },
          "response": [
            {
              "name": "200 OK - Rain Expected",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"probability\": {\n    \"no_rain\": 32.5,\n    \"rain\": 67.5\n  },\n  \"rain_tomorrow\": \"Yes\",\n  \"status\": \"success\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has rain_tomorrow field', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('rain_tomorrow');",
                  "    pm.expect(['Yes', 'No']).to.include(json.rain_tomorrow);",
                  "});",
                  "pm.test('Response has probability object', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.probability).to.have.property('rain');",
                  "    pm.expect(json.probability).to.have.property('no_rain');",
                  "});",
                  "pm.test('Probabilities sum to 100', function () {",
                  "    var json = pm.response.json();",
                  "    var total = json.probability.rain + json.probability.no_rain;",
                  "    pm.expect(total).to.be.closeTo(100, 0.5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
