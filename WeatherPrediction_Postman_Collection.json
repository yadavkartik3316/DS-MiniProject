      "name": "1. Predict Temperature",
      "item": [
        {
          "name": "Test 1 - Valid Request (Sydney, Normal Weather)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"min_temp\": 12,\n  \"max_temp\": 26,\n  \"humidity\": 65,\n  \"wind_speed\": 20,\n  \"pressure\": 1015,\n  \"sunshine\": 7,\n  \"evaporation\": 5,\n  \"cloud\": 3,\n  \"wind_dir\": \"N\",\n  \"location\": \"Sydney\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/predict-temperature",
              "host": ["{{base_url}}"],
              "path": ["predict-temperature"]
            },
            "description": "Valid request with all fields. Expects 200 OK with predicted_temperature."
          },
          "response": [
            {
              "name": "200 OK - Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"predicted_temperature\": 20.41,\n  \"status\": \"success\",\n  \"unit\": \"°C\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has predicted_temperature', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('predicted_temperature');",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json.unit).to.eql('°C');",
                  "});",
                  "pm.test('Temperature is a number', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.predicted_temperature).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
